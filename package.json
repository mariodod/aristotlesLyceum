{
  "name": "aristotles-lyceum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 2D pixel-art narrative game about Aristotle, his philosophy, and where it still runs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariodod/aristotlesLyceum.git"
  },
  "homepage": "https://mariodod.github.io/aristotlesLyceum/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "assets": "node tools/assets/build-assets.mjs",
    "content:check": "node tools/content/check-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
